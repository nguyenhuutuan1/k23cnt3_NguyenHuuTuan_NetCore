@model IEnumerable<NguyenHuuTuan_2310900112.Models.NhtEmployee>

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
