@model List<NhtLab06.Models.NhtEmployee>

@{
    ViewData["Title"] = "Danh sách nhân viên";
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
<div class="d-flex justify-content-between align-items-center">
        <h2 class="my-4">Danh sách nhân viên</h2>
        <a href="/NhtEmployee/NhtCreate" class="btn btn-primary">Thêm mới </a>
    </div>


<table class="table table-bordered table-striped">
    <thead class="table-dark">
        <tr>
            <th>Mã NV</th>
            <th>Họ tên</th>
            <th>Ngày sinh</th>
            <th>Email</th>
            <th>Điện thoại</th>
            <th>Lương</th>
            <th>Trạng thái</th>
            <th>Thao tác</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var nhtEmp in Model)
        {
            <tr>
                <td>@nhtEmp.NhtId</td>
                <td>@nhtEmp.NhtName</td>
                <td>@nhtEmp.NhtBirthDay.ToString("dd/MM/yyyy")</td>
                <td>@nhtEmp.NhtEmail</td>
                <td>@nhtEmp.NhtPhone</td>
                <td>@nhtEmp.NhtSalary.ToString("N0")</td>
                <td>
                    @(nhtEmp.NhtStatus ? "Đang làm" : "Nghỉ")
                </td>
                <td>
                    <a class="btn btn-sm btn-warning" asp-action="NvkEdit" asp-route-id="@nhtEmp.NhtId">Sửa</a>
                    <a class="btn btn-sm btn-danger" asp-action="NvkDelete" asp-route-id="@nhtEmp.NhtId">Xoá</a>
                </td>
            </tr>
        }
    </tbody>
</table>
